{
	"name": "testing-app",
	"$schema": "../../node_modules/nx/schemas/project-schema.json",
	"projectType": "application",
	"sourceRoot": "apps/testing-app/src",
	"targets": {
		"start": {
			"executor": "@nx/vite:dev-server",
			"options": {
				"buildTarget": "testing-app:build.client",
				"mode": "ssr",
				"port": 5173
			}
		},
		"build": {
			"executor": "qwik-nx:build",
			"options": {
				"runSequence": [
					"testing-app:build.client",
					"testing-app:build.ssr"
				],
				"outputPath": "dist/apps/testing-app",
				"postcssConfig": "apps/testing-app/postcss.config.js",
				"skipTypeCheck": true
			},
			"configurations": {
				"preview": {}
			}
		},
		"build.client": {
			"executor": "@nx/vite:build",
			"options": {
				"outputPath": "dist/apps/testing-app",
				"configFile": "apps/testing-app/vite.config.ts",
				"skipTypeCheck": true
			}
		},
		"build.ssr": {
			"executor": "@nx/vite:build",
			"options": {
				"outputPath": "dist/apps/testing-app/server",
				"configFile": "apps/testing-app/adapters/express/vite.config.ts",
				"skipTypeCheck": true
			}
		},
		"qwik-speak-extract": {
			"executor": "nx:run-commands",
			"options": {
				"command": "bash ../../scripts/get-project-dependencies/qwik-speak-extract.sh testing-app",
				"cwd": "apps/testing-app"
			}
		}
	},
	"tags": []
}
